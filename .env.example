# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the
# browser; everything else is server-only and must NEVER be sent to the client
# or committed. See SETUP.md for where to get each value.

# ── Site ──────────────────────────────────────────────────────────────────
# Canonical origin for metadata, sitemap, JSON-LD, OG and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://agama-3d-studio.vercel.app

# ── Tax (Slovak DPH) ──────────────────────────────────────────────────────
# ⚠️ Set to "true" ONLY if the company is a REGISTERED VAT payer (platiteľ DPH,
# i.e. it has an IČ DPH from a §4 registration). Having a DIČ is NOT enough.
# §69 ods. 5 zákona o DPH: stating VAT on a sales document obliges you to PAY it
# to the state — so a non-registered shop showing a DPH line creates a real tax
# debt. Default (unset/false) = no DPH line anywhere. Verify at financnasprava.sk
# and confirm with your účtovník before switching this on.
NEXT_PUBLIC_IS_VAT_PAYER=false
# VAT rate as a decimal, used only when IS_VAT_PAYER=true. Blank = 0.23 (SK standard).
# Prices are VAT-INCLUSIVE: VAT is BACKED OUT (vat = total − total/(1+rate)), never
# added on top, so displayed prices never change.
NEXT_PUBLIC_VAT_RATE=0.23

# ── Supabase (auth + Postgres) ────────────────────────────────────────────
# Project Settings → API. URL + anon key are public (RLS-guarded).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security (order writes, inventory). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (cards + Apple Pay) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From the webhook endpoint you register (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (order confirmations) ───────────────────────────────────────────
# Resend (EU data residency for GDPR). Without these, emails are logged to the
# server console instead of sent (safe local default).
RESEND_API_KEY=
EMAIL_FROM="Agama 3D Studio <objednavky@vasa-domena.sk>"

# ── GoPay (optional SK/CZ bank buttons; see src/lib/payments/gopay.ts) ─────
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=

# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the
# browser; everything else is server-only and must NEVER be sent to the client
# or committed. See SETUP.md for where to get each value.

# ── Site ──────────────────────────────────────────────────────────────────
# Canonical origin for metadata, sitemap, JSON-LD, OG and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://agama-3d-studio.vercel.app

# ── Tax (Slovak DPH) ──────────────────────────────────────────────────────
# VAT rate as a decimal. Catalog prices are VAT-INCLUSIVE (gross): this only
# shows the "z toho DPH" breakdown by BACKING VAT OUT (vat = total − total/(1+rate));
# it never adds tax on top, so prices don't change. Defaults to 0.23 (SK standard)
# even if unset. Set to an empty value to DISABLE the VAT line.
NEXT_PUBLIC_VAT_RATE=0.23

# ── Supabase (auth + Postgres) ────────────────────────────────────────────
# Project Settings → API. URL + anon key are public (RLS-guarded).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security (order writes, inventory). NEVER expose.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (cards + Apple Pay) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From the webhook endpoint you register (Dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (order confirmations) ───────────────────────────────────────────
# Resend (EU data residency for GDPR). Without these, emails are logged to the
# server console instead of sent (safe local default).
RESEND_API_KEY=
EMAIL_FROM="Agama 3D Studio <objednavky@vasa-domena.sk>"

# ── GoPay (optional SK/CZ bank buttons; see src/lib/payments/gopay.ts) ─────
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
